# Copy this file to .env.local and enter your own API key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash
# auto selects Chat Completions for DeepSeek and Responses for other endpoints.
# Set responses or chat_completions explicitly for another compatible provider.
UBIGRAPH_API_STYLE=auto
# Applies to the Responses interface. Chat Completions does not request reasoning.
OPENAI_REASONING_EFFORT=low
# Optional local vehicle-detection weights; blank keeps Vision unconfigured.
UBIGRAPH_DETECTION_WEIGHTS=
